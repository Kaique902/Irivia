# Supabase
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key-here
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Admin setup (used by /api/admin/setup)
ADMIN_SETUP_SECRET=your-secret-here

# Site URL (used for OG images, sitemap, etc.)
NEXT_PUBLIC_SITE_URL=https://irivia.app

# Sentry (error monitoring)
NEXT_PUBLIC_SENTRY_DSN=https://your-dsn@sentry.io/your-project
SENTRY_ORG=your-sentry-org
SENTRY_PROJECT=your-sentry-project
